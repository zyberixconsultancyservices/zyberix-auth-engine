# Zyberix Auth Engine — Environment Template
# Copy to .env and fill in real secrets. Never commit .env.

ZYBERIX_PORT=8443
ZYBERIX_MASTER_KEY=              # 32-byte base64 key; generate with: openssl rand -base64 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=

ZYBERIX_SMTP_HOST=
ZYBERIX_SMTP_PORT=587
ZYBERIX_SMTP_USER=
ZYBERIX_SMTP_PASS=

ZYBERIX_WHATSAPP_TOKEN=
ZYBERIX_TELEGRAM_BOT_TOKEN=
